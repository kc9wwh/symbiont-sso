# symbiont environment. Copy to symbiont.env (gitignored) and fill in.
# Secrets can instead be supplied as files via the *_FILE variants, which
# docker-compose.example.yml uses.

# Public HTTPS URL of the bridge (no path). Users must only reach it here.
SYMBIONT_BASE_URL=https://saml.example.com
# SYMBIONT_LISTEN_ADDR=:8080

# Service provider definitions (see examples/symbiont.yaml).
SYMBIONT_SP_CONFIG_FILE=/etc/symbiont/symbiont.yaml

# Peers whose CF-Connecting-IP / X-Forwarded-For are trusted for logging
# client_ip. For cloudflared on the compose network, use the network's
# subnet (docker network inspect <net>). Leave unset when not behind a proxy.
# SYMBIONT_TRUSTED_PROXIES=172.16.0.0/12
# Prefer CF-Connecting-IP from those peers. Only when they are Cloudflare.
# SYMBIONT_TRUST_CF_CONNECTING_IP=true

# Upstream OpenID Connect provider (e.g. Pocket ID). Must match the
# discovery document's issuer exactly.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=           # or OIDC_CLIENT_SECRET_FILE
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_SCOPES=openid email profile groups
# OIDC_EMAIL_CLAIM=email
# OIDC_NAME_CLAIM=name
# OIDC_GROUPS_CLAIM=groups
# OIDC_FETCH_USERINFO=true
# OIDC_PROMPT=login             # force IdP re-authentication every time
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# ALLOWED_EMAIL_DOMAINS=example.com

# SAML signing key pair (symbiont gencert --cn saml.example.com).
SAML_CERT_FILE=/run/secrets/saml_cert.pem
SAML_KEY_FILE=/run/secrets/saml_key.pem

# >= 32 random bytes, base64 (openssl rand -base64 32).
# SESSION_SECRET=               # or SESSION_SECRET_FILE
SESSION_SECRET_FILE=/run/secrets/session_secret
# SESSION_TTL=60s
# PENDING_REQUEST_TTL=10m

# Per-client cap on starting a login, i.e. redirects to the IdP (0 disables). Behind a proxy,
# set SYMBIONT_TRUSTED_PROXIES too, or all users share one budget.
# SYMBIONT_RATE_LIMIT_PER_MINUTE=60

# LOG_LEVEL=info
